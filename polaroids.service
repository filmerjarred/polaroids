[Unit]
Description=Polaroids (photos pinned to the desktop)

[Service]
Type=simple
WorkingDirectory=__HERE__
Environment=DISPLAY=:0
Environment=XAUTHORITY=__HOME__/.Xauthority
ExecStart=/usr/bin/python3 __HERE__/polaroids.py
# Quit from the tray exits cleanly and stays stopped; a crash or lost X connection brings it back.
Restart=on-failure
RestartSec=3
SyslogIdentifier=polaroids
